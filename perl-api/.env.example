PORT=4000
NODE_ENV=development
DATA_LAYER=mock
IMAGE_STORAGE=mock
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=dev-phase-2-secret
JWT_COOKIE_NAME=perl_session
JWT_EXPIRES_IN_SECONDS=28800
COOKIE_SECURE=false
# Legacy aliases (still read by env.ts for backward compat, prefer the *_SYSTEM_ADMIN_* names above):
# INITIAL_SUPERADMIN_EMAIL, INITIAL_SUPERADMIN_PASSWORD
INITIAL_SYSTEM_ADMIN_EMAIL=system@perl.system
INITIAL_SYSTEM_ADMIN_PASSWORD=SystemAdmin123!
INITIAL_SUPPORT_EMAIL=support@perl.system
INITIAL_SUPPORT_PASSWORD=Support123!
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=perl
DB_PASSWORD=perl_dev_password
DB_NAME=perl
DB_SSL=false
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN is optional - only needed when using temporary/STS credentials.
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
DEVICE_SCAN_RATE_LIMIT_WINDOW_MS=60000
DEVICE_SCAN_RATE_LIMIT_MAX_ATTEMPTS=10
SMS_ENABLED=true
SMS_PROVIDER=mock
# SEMAPHORE_API_KEY is the current name; legacy alias SMS_API_KEY is still read for backward compat.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE
SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages

# Demo tenant seeding (any NODE_ENV, including production): creates exactly one demo school
# plus one ADMIN user for it. DEMO_ADMIN_EMAIL and DEMO_ADMIN_PASSWORD are required (no
# default) when SEED_DEMO_TENANT=true; in production DEMO_ADMIN_PASSWORD must be >= 12 chars.
SEED_DEMO_TENANT=false
DEMO_SCHOOL_NAME=PERL Demo Academy
DEMO_SCHOOL_SLUG=perl-demo
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
